{
  "name": "clinic-management-system",
  "version": "1.0.0",
  "description": "Clinic Management System",
  "main": "main.js",
  "scripts": {
    "build": "cd frontend && npm run build && cd .. && electron-builder build",
    "start-electron": "electron .",
    "start-java": "java -jar backend/out/artifacts/backend_jar/backend.jar --spring.profiles.active=prod",
    "start-vite": "cd frontend && npm run dev",
    "start-spring-boot": "cd backend && mvnw spring-boot:run",
    "start": "start cmd.exe /c \"npm run start-spring-boot\" && start cmd.exe /c \"npm run start-vite\" && npm run start-electron",
    "dev": "concurrently \"npm run start-electron\" \"npm run start-vite\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.ppag7.cms",
    "productName": "Clinic Management System",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!frontend/*",
      "!backend/*",
      {
        "from": "frontend/dist",
        "to": "renderer"
      }
    ],
    "extraResources": [
      {
        "from": "backend/out/artifacts/backend_jar",
        "to": "be"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png"
    }
  },
  "author": "TDDSriyantha",
  "license": "MIT",
  "devDependencies": {
    "electron": "^34.1.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@mui/x-charts": "^8.2.0",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7"
  }
}
