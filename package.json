{
  "name": "clinic-management-system",
  "version": "1.0.0",
  "description": "Clinic Management System",
  "main": "main.js",
  "scripts": {
    "build": "electron-builder build",
    "start-electron": "electron .",
    "start-java": "java -jar backend/out/artifacts/backend_jar/backend.jar",
    "start-vite": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run start-electron\" \"npm run start-vite\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.ppag7.cms",
    "productName": "Clinic Management System",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!frontend/*",
      "!backend/*",
      {
        "from": "frontend/dist",
        "to": "renderer"
      }
    ],
    "extraResources": [
      {
        "from": "backend/out/artifacts/backend_jar",
        "to": "be"
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "build/icon.png"
    }
  },
  "author": "TDDSriyantha",
  "license": "MIT",
  "devDependencies": {
    "electron": "^34.1.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "concurrently": "^9.1.2",
    "react-helmet-async": "^2.0.5"
  }
}
